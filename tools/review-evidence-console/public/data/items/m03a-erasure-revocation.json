      "options": ["hide_metadata", "show_revoked_state"]
    },
    {
      "key": "retentionNote",
      "labelSq": "Shënimi i ruajtjes",
      "type": "text",
      "required": true,
      "maxLength": 160,
      "options": [],
      "requiredWhen": { "key": "renderingRule", "equals": "show_revoked_state" }
    }
  ]
}
