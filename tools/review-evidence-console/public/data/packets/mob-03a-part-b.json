{
  "id": "mob-03a-part-b",
  "version": "1",
  "reviewerRole": "privacy",
  "title": "MOB-03a fixture authority review — part B",
  "scope": "Repo-safe car and property display planning only; no documents or sensitive content are included.",
  "stopConditions": [
    "Stop if a raw document is requested",
    "Stop if scope becomes medical or injury related"
  ],
  "itemIds": [
    "M03A-DOCUMENT-BOUNDARY",
    "M03A-THREAT-RECHECK",
    "M03A-ERASURE-REVOCATION",
    "M03A-SCOPE-STOPS"
  ],
  "items": [
    {
      "id": "M03A-DOCUMENT-BOUNDARY",
      "prompt": "Which metadata is allowed?",
      "need": "Document boundaries remain explicit.",
      "repoImpact": "Prevents source-document display.",
      "guidance": "Use metadata labels only.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["privacy", "security"],
      "requiredResponses": [
        {
          "key": "allowedMetadata",
          "labelSq": "Metadatat e lejuara",
          "type": "checkbox_group",
          "required": true,
          "maxLength": 160,
          "options": ["state", "category", "updatedAt"]
        },
        {
          "key": "forbiddenCategory",
          "labelSq": "Kategoria e ndaluar",
          "type": "select",
          "required": true,
          "maxLength": 24,
          "options": ["raw_document", "payment", "medical", "legal_private"]
        }
      ]
    },
    {
      "id": "M03A-THREAT-RECHECK",
      "prompt": "Which threat areas were rechecked?",
      "need": "The review captures a repo-safe threat signal.",
      "repoImpact": "Keeps the design gate observable.",
      "guidance": "Reference repository evidence only.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["security", "access"],
      "requiredResponses": [
        {
          "key": "threatAreas",
          "labelSq": "Fushat e kërcënimit",
          "type": "multi_select",
          "required": true,
          "maxLength": 160,
          "options": ["access", "retention", "disclosure"]
        },
        {
          "key": "recheckOutcome",
          "labelSq": "Rezultati i rikontrollit",
          "type": "radio",
          "required": true,
          "maxLength": 8,
          "options": ["clear", "change", "stop"]
        }
      ]
    },
    {
      "id": "M03A-ERASURE-REVOCATION",
      "prompt": "What rendering rule applies after revocation?",
      "need": "The fixture communicates the removal boundary.",
      "repoImpact": "Avoids stale display assumptions.",
      "guidance": "Choose one rendering rule.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["privacy", "compliance"],
      "requiredResponses": [
        {
          "key": "renderingRule",
          "labelSq": "Rregulli i shfaqjes",
          "type": "select",
          "required": true,
          "maxLength": 32,
          "options": ["hide_metadata", "show_revoked_state"]
        },
        {
          "key": "retentionNote",
          "labelSq": "Shënimi i ruajtjes",
          "type": "text",
          "required": true,
          "maxLength": 160,
          "options": [],
          "requiredWhen": { "key": "renderingRule", "equals": "show_revoked_state" }
        }
      ]
    },
    {
      "id": "M03A-SCOPE-STOPS",
      "prompt": "What scope and stop conditions apply?",
      "need": "The implementation boundary stays narrow.",
      "repoImpact": "Blocks unauthorized runtime expansion.",
      "guidance": "State allowed and excluded fixture scope.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["scope", "legal"],
      "requiredResponses": [
        {
          "key": "allowedScope",
          "labelSq": "Fusha e lejuar",
          "type": "textarea",
          "required": true,
          "maxLength": 240,
          "options": []
        },
        {
          "key": "stopCondition",
          "labelSq": "Kushti i ndalimit",
          "type": "radio",
          "required": true,
          "maxLength": 24,
          "options": ["missing_authority", "sensitive_data", "scope_expansion"]
        }
      ]
    }
  ]
}
