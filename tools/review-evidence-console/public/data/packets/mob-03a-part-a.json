{
  "id": "mob-03a-part-a",
  "version": "1",
  "reviewerRole": "privacy",
  "title": "MOB-03a fixture authority review — part A",
  "scope": "Repo-safe car and property display planning only; medical and injury data are excluded.",
  "stopConditions": ["Stop if sensitive data is supplied", "Stop if authority is missing"],
  "itemIds": [
    "M03A-PRIVACY-OWNER",
    "M03A-MEDICAL-BOUNDARY",
    "M03A-CONSENT-FIELDS",
    "M03A-ACCESS-ROLES"
  ],
  "items": [
    {
      "id": "M03A-PRIVACY-OWNER",
      "prompt": "Who owns the fixture decision?",
      "need": "Ownership is explicit.",
      "repoImpact": "Keeps responsibility local.",
      "guidance": "Use fixture roles only.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["privacy", "legal"],
      "requiredResponses": [
        {
          "key": "ownerRole",
          "labelSq": "Roli i pronarit",
          "type": "text",
          "required": true,
          "maxLength": 80,
          "options": []
        },
        {
          "key": "decisionDate",
          "labelSq": "Data e vendimit",
          "type": "date",
          "required": true,
          "maxLength": 10,
          "options": []
        }
      ]
    },
    {
      "id": "M03A-MEDICAL-BOUNDARY",
      "prompt": "Is medical or injury data excluded?",
      "need": "The sensitive-data boundary must remain closed.",
      "repoImpact": "Prevents scope expansion.",
      "guidance": "Confirm excluded for this fixture.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["privacy", "legal"],
      "requiredResponses": [
        {
          "key": "medicalBoundary",
          "labelSq": "Kufiri mjekësor",
          "type": "select",
          "required": true,
          "maxLength": 8,
          "options": ["excluded", "allowed"]
        },
        {
          "key": "disabledScope",
          "labelSq": "Deklarata e çaktivizimit",
          "type": "textarea",
          "required": true,
          "maxLength": 240,
          "options": [],
          "requiredWhen": { "key": "medicalBoundary", "equals": "excluded" }
        },
        {
          "key": "dpiaReference",
          "labelSq": "Referenca DPIA",
          "type": "text",
          "required": true,
          "maxLength": 160,
          "options": [],
          "requiredWhen": { "key": "medicalBoundary", "equals": "allowed" }
        }
      ]
    },
    {
      "id": "M03A-CONSENT-FIELDS",
      "prompt": "Which minimum consent fields are accepted?",
      "need": "The fixture field boundary is reviewable.",
      "repoImpact": "Limits displayed consent metadata.",
      "guidance": "List fixture-only field labels.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["privacy", "compliance"],
      "requiredResponses": [
        {
          "key": "acceptedFields",
          "labelSq": "Fushat e pranuara",
          "type": "multi_select",
          "required": true,
          "maxLength": 160,
          "options": ["status", "recordedAt", "version"]
        },
        {
          "key": "excludedFields",
          "labelSq": "Fushat e përjashtuara",
          "type": "textarea",
          "required": true,
          "maxLength": 240,
          "options": []
        }
      ]
    },
    {
      "id": "M03A-ACCESS-ROLES",
      "prompt": "Which fixture roles may view metadata?",
      "need": "Access assumptions need review.",
      "repoImpact": "Preserves role-bound display planning.",
      "guidance": "Do not imply authorization changes.",
      "baseFields": ["decision", "concreteAnswer", "reason", "evidenceRef", "verifiedAt"],
      "allowedRiskCategories": ["access", "privacy"],
      "requiredResponses": [
        {
          "key": "memberDecision",
          "labelSq": "Vendimi për anëtarin",
          "type": "radio",
          "required": true,
          "maxLength": 8,
          "options": ["view", "exclude"]
        },
        {
          "key": "externalPartyDecision",
          "labelSq": "Vendimi për palën e jashtme",
          "type": "radio",
          "required": true,
          "maxLength": 8,
          "options": ["exclude", "escalate"]
        }
      ]
    }
  ]
}
