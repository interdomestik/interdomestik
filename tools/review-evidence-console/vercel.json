{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/api/index(?:/.*)?$", "status": 404 },
    {
      "src": "^/api$",
      "dest": "/api/index",
      "headers": { "x-rec-rewrite-kind": "root", "x-rec-rewrite-path": "-" }
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index",
      "headers": { "x-rec-rewrite-kind": "path", "x-rec-rewrite-path": "$1" }
    },
    { "handle": "filesystem" }
  ]
}
