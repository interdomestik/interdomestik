#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  checkout=$(mktemp -d "${TMPDIR:-/tmp}/interdomestik-repo-size.XXXXXX")
  cleanup() {
    git -C "$repo_root" worktree remove --force "$checkout" >/dev/null 2>&1 || true
    rm -rf "$checkout"
  }
  trap cleanup EXIT HUP INT TERM
  git -C "$repo_root" worktree add --quiet --detach "$checkout" "$local_sha"
  node "$checkout/scripts/repo-size-audit.mjs" --check
  cleanup
  trap - EXIT HUP INT TERM
done
