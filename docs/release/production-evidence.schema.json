{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interdomestik production evidence hash manifest",
  "type": "object",
  "required": ["gates"],
  "additionalProperties": false,
  "properties": {
    "gates": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "description", "required_artifacts", "owner", "status", "signoff"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^G(0[1-9]|10)$" },
          "description": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pending", "supplied", "approved", "verified", "waived"]
          },
          "required_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "sha256"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
              }
            }
          },
          "signoff": {
            "type": "object",
            "required": ["signer_ref", "role", "signed_at"],
            "additionalProperties": false,
            "properties": {
              "signer_ref": { "type": "string", "minLength": 1 },
              "role": { "type": "string" },
              "signed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    }
  }
}
